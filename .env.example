# Postgres 连接串（应用与数据库同机）
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ielts

# 用于加密 JWT
PAYLOAD_SECRET=YOUR_SECRET_HERE

# 站点地址，用于 CORS 和生成链接，不要尾斜杠
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# 定时任务鉴权
CRON_SECRET=YOUR_CRON_SECRET_HERE

# 预览请求校验
PREVIEW_SECRET=YOUR_SECRET_HERE

# —— 香港对象存储（S3 兼容，如阿里云 OSS 香港）。不配置 S3_BUCKET 时媒体存本地 public/media ——
# 存储桶名称
S3_BUCKET=
# 地域，如 oss-cn-hongkong
S3_REGION=
# S3 兼容接入点，如 https://oss-cn-hongkong.aliyuncs.com
S3_ENDPOINT=
# 访问密钥 ID（只放服务端环境变量）
S3_ACCESS_KEY_ID=
# 访问密钥（只放服务端环境变量）
S3_SECRET_ACCESS_KEY=
# 浏览器访问媒体的公开域名（OSS 或其 CDN），无尾斜杠，如 https://media.example.com
S3_PUBLIC_URL=
