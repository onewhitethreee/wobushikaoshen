{
  "name": "site",
  "version": "0.7.2",
  "description": "Website template for Payload",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "convert": "tsx scripts/convert/index.ts",
    "import:dir": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/import-dir.ts",
    "import:dict": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/import-dict.ts",
    "chart:data": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/chart-data.ts",
    "mock:compose": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/mock-compose.ts",
    "paraphrase": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/paraphrase.ts",
    "check:secrets": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/check-bundle-secrets.ts",
    "backfill:summary": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/backfill-unit-summary.ts",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@payloadcms/admin-bar": "3.90.2",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-nested-docs": "3.90.2",
    "@payloadcms/plugin-redirects": "3.90.2",
    "@payloadcms/plugin-search": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.2",
    "lucide-react": "0.563.0",
    "next": "16.4.3",
    "next-sitemap": "^4.2.3",
    "nodemailer": "10.1.0",
    "payload": "3.90.2",
    "prism-react-renderer": "^2.3.1",
    "qrcode-generator": "2.0.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.71.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.4.0",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "16.3.0",
    "@types/escape-html": "^1.0.2",
    "@types/node": "22.19.9",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "28.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.18",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20.18.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
